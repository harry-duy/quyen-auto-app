# ============================================================
#  Quyen Auto — Backend Environment Template
#  Copy file nay thanh .env roi dien gia tri thuc te
#  File .env duoc gitignore — KHONG commit len git
# ============================================================

# Database — dien password MySQL cua may ban
DB_URL=jdbc:mysql://localhost:3306/quyen_auto?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Ho_Chi_Minh&createDatabaseIfNotExist=true
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# JWT — giu nguyen khi dev, doi khi deploy production
JWT_SECRET=quyen-auto-dev-secret-2024-change-me-in-prod-abc123xyz

# Mail (tuy chon khi dev — de trong cung duoc)
MAIL_USERNAME=
MAIL_PASSWORD=

# Cloudinary — upload anh (tuy chon khi dev)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Firebase FCM — de trong khi dev, push notification se bi bo qua
# Trong production: dan noi dung firebase-service-account.json vao day (1 dong JSON)
FIREBASE_SERVICE_ACCOUNT_JSON=
