# ============================================================
#  Quyen Auto — Dev Environment Template
#  Copy file nay thanh .env va dien gia tri thuc te.
#  .env da duoc gitignore — KHONG commit .env that.
# ============================================================

# Database
DB_URL=jdbc:mysql://localhost:3306/quyen_auto?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Ho_Chi_Minh&createDatabaseIfNotExist=true
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# JWT — phai >= 32 ky tu, dung ky tu ngau nhien
JWT_SECRET=your-random-jwt-secret-at-least-32-chars-long

# Mail — Dung Gmail App Password (khong phai mat khau Gmail)
# Huong dan: myaccount.google.com > Security > App passwords
MAIL_USERNAME=your-gmail@gmail.com
MAIL_PASSWORD=your-16-char-app-password

# Cloudinary (upload anh) — dang ky tai cloudinary.com mien phi
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Firebase Admin SDK (FCM Push Notification)
# Lay tu Firebase Console > Project Settings > Service Accounts > Generate new private key
# Dan toan bo noi dung file JSON vao 1 dong (khong xuong dong)
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project-id",...}
